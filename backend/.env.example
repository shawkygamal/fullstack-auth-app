NODE_ENV=development
APP_PORT=3000
MONGODB_URI=mongodb://localhost:27017/auth-app
# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Access token lifetime; the refresh token (httpOnly cookie) renews it
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
# The refresh cookie is HTTPS-only when true. Keep true anywhere but plain-HTTP local development.
COOKIE_SECURE=false
# Number of reverse proxies in front of the API (nginx in Docker = 1), so rate limits see the real client IP
TRUST_PROXY_HOPS=0
# Only needed when the web app is served from another origin (the dev server proxies /api, so it is not)
CORS_ORIGINS=http://localhost:5173
# Least severe level printed: verbose, debug, log (default), warn, error or fatal
LOG_LEVEL=log
# API docs at /api/docs. When unset: on everywhere except production
# SWAGGER_ENABLED=true
